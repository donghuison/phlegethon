! MPI WALL CLOCK TIME
!>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
 
 function get_wtime(mgrid) result(wct)
   type(mpigrid),intent(inout) :: mgrid
   real(kind=rp) :: wct, tmp(1)
   integer :: ierr

   tmp(1) = real(mpi_wtime(),kind=rp)
   call mpi_bcast(tmp,1,MPI_RP,master_rank,mgrid%comm_cart,ierr)
   wct = tmp(1)

 end function get_wtime

